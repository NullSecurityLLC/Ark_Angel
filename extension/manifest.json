{
  "manifest_version": 3,
  "name": "ArkAngel Recorder",
  "version": "0.1.0",
  "description": "Logs your investigation browsing into an ArkAngel case on this computer, and flags pages that match the case.",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {"default_popup": "popup.html", "default_title": "ArkAngel Recorder",
             "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "background": {"service_worker": "background.js", "scripts": ["background.js"]},
  "permissions": ["storage", "tabs", "scripting", "contextMenus", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "incognito": "not_allowed",
  "browser_specific_settings": {"gecko": {"id": "recorder@ark-angel.nullsecurity", "strict_min_version": "121.0"}}
}
