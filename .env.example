# Copy to .env and fill in. DNS for DOMAIN must point at this server before you start.
DOMAIN=arkangel.example.org
# For certificate expiry notices from Let's Encrypt (optional but recommended).
ACME_EMAIL=you@example.org
# Shown in the site header and page titles.
SITE_NAME=ArkAngel

# Email notifications (optional). Leave SMTP_HOST empty to send no email.
# Any SMTP provider works: Postmark, Mailgun, Amazon SES, Fastmail, your own mail server...
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587, the usual) or ssl (port 465). Plain-text "none" is refused unless the host is localhost.
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# The address emails come from. Use one your provider has verified for your domain.
SMTP_FROM=alerts@example.org
# Extra address(es) for admin alerts, comma-separated (admins' own account emails get them too).
ADMIN_EMAIL=

# Nightly encrypted backups. Until BACKUP_RECIPIENT is set, the backup service only warns (and emails admins daily).
# On YOUR computer, not the server: age-keygen -o arkangel-backup-key.txt  and paste the "public key" here.
# Keep that key file safe and off the server: without it nobody can open the backups, including you.
BACKUP_RECIPIENT=
# Where to copy them, as rclone REMOTE:path. Configure the remote below. Empty = this server only (not safe).
BACKUP_DEST=offsite:my-bucket/arkangel
# Example remote "offsite" on Backblaze B2 (any rclone backend works: s3, r2 via s3, sftp, drive...):
RCLONE_CONFIG_OFFSITE_TYPE=b2
RCLONE_CONFIG_OFFSITE_ACCOUNT=
RCLONE_CONFIG_OFFSITE_KEY=
# Daily time (UTC), and how many days of backups to keep off-site.
BACKUP_AT=03:15
BACKUP_KEEP_DAYS=30
# Optional dead man's switch: pinged after each good backup (e.g. a healthchecks.io check URL).
BACKUP_PING_URL=
